# HTTPS reverse proxy. SITE_ADDRESS is your domain (certificate from Let's Encrypt, automatically)
# or "localhost" (certificate from Caddy's own local CA).
{
	# Keep the redirect off so the default local setup works on the non-standard ports in docker-compose.yml.
	auto_https disable_redirects
}

{$SITE_ADDRESS:localhost} {
	encode zstd gzip
	reverse_proxy app:8080
}
